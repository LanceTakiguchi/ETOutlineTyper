              "subsections": [
                {
                  "section": "2.4.1.1",
                  "heading": "Romans 6:23",
                  "subsections": [
                    {
                      "section": "2.4.1.1.1",
                      "heading": "For the wages of sin is death, but the free gift of God is eternal life in Christ Jesus"
                    }
                  ]
                }
              ]
            },
            {
              "section": "2.4.2",
              "heading": "It is not earned or deserved",
              "subsections": [
                {
                  "section": "2.4.2.1",
                  "heading": "Ephesians 2:8-9",
                  "subsections": [
                    {
                      "section": "2.4.2.1.1",
                      "heading": "For by grace you have been saved, through faith, and this is not your own doing, it is the gift of God, not a result of works, so that no one may boast."
                    }
                  ]
                }
              ]
            },
            {
              "section": "2.4.3",
              "heading": "Transition: All you have to do to receive this gift is to put your faith in Jesus Christ"
            }
          ]
