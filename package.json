    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.23",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.1.6",
    "vite": "^5.1.3",
    "@vitejs/plugin-react": "^4.0.3"
  }
